## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore file is for .NET Core / .NET 5+

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache and settings
.vs/
*.user
*.userosscache
*.sln.docstates

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# SQLite
*.db
*.db-shm
*.db-wal

# OS-specific files
.DS_Store
Thumbs.db

# Logs
SoftBook.API/audit_logs/
SoftBook.API/build_log.txt

# Build folders
bin/
obj/
.vs/

# IMPORTANT - DO NOT IGNORE STATIC FILES
!SoftBook.API/wwwroot/
!SoftBook.API/wwwroot/Uploads/

# Debug / temp
dbtest/
*debug*.cs

# Secrets
appsettings.Development.json
appsettings.Local.json